# Spotify app details. The client secret and refresh token stay server-side.
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
# Local token helper only; register this exact loopback URI in Spotify.
SPOTIFY_REDIRECT_URI=http://127.0.0.1:8888/callback
SPOTIFY_REFRESH_TOKEN=
SPOTIFY_PLAYLIST_ID=59OqDrBVYGT8ViZFUUDA9t

# Public browser key. Restrict to your website and the Maps JavaScript API.
GOOGLE_MAPS_API_KEY=

# Admin panel
ADMIN_PASSWORD=
SESSION_SECRET=

# Cloudflare Turnstile. Site key is public; secret key is private.
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Privacy, request validation, and limits
IP_HASH_SALT=
SITE_ORIGIN=http://localhost:8888
ALLOW_EXPLICIT=true
MAX_PENDING=300
